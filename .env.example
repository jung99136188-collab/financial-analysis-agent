# LLM Provider
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat

# Analyst / Writer overrides (optional, defaults to LLM_MODEL)
# ANALYST_PROVIDER=gemini
# ANALYST_MODEL=gemini-2.5-flash
# WRITER_PROVIDER=openai_compatible
# WRITER_MODEL=deepseek-reasoner

# Elasticsearch
ES_HOST=http://your-es-host:9201
ES_USER=your-username
ES_PASSWORD=your-password

# UZI-Skill (optional)
UZI_ENABLED=false
UZI_PATH=../UZI-Skill

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
